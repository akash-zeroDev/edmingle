generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Institute {
  id               String   @id @default(cuid())
  clerkOrgId       String   @unique
  name             String
  location         String?
  adminEmail       String
  phoneNo          String?
  joinedAt         DateTime @default(now())
  
  subscriptionType String   @default("FREE")
  subsInfo         String?
  paymentStatus    String   @default("PAID") // "PAID" | "OVERDUE" | "PENDING"
  isActive         Boolean  @default(true)

  teachers         Teacher[]
  students         Student[]
  batches          Batch[]
  invoices         InstituteInvoice[]
  supportTickets   SupportTicket[]
  teacherPayouts   TeacherPayout[]
  attendance       Attendance[]
  announcements    Announcement[]
}

model Teacher {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  name        String
  email       String?
  address     String?
  phoneNo     String?
  salary      Float?
  subjects    String?
  status      String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  batchesTaught Batch[]
  payouts       TeacherPayout[]
  announcements Announcement[]
}

model Batch {
  id          String   @id @default(cuid())
  batchName   String?
  className   String
  subject     String
  timing      String?

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])
  
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])

  students      BatchEnrollment[]
  attendance    Attendance[]
  announcements Announcement[]
}

model Student {
  id          String   @id @default(cuid())
  clerkUserId String?  @unique
  name        String
  address     String?
  phoneNo     String?
  parentPhone String?
  email       String?
  status      String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED"
  joinedAt    DateTime @default(now())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id])

  batches     BatchEnrollment[]
  attendance  Attendance[]
  fees        Fee[]
  payments    FeePayment[]
}

model BatchEnrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  batchId   String
  batch     Batch   @relation(fields: [batchId], references: [id])
}

model Attendance {
  id          String    @id @default(cuid())
  date        DateTime
  status      String    @default("PRESENT") // "PRESENT", "ABSENT", "LATE", "EXCUSED"
  remarks     String?
  markedBy    String?   // Teacher name or "Admin"

  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@unique([studentId, batchId, date])
  @@index([instituteId, date])
  @@index([batchId, date])
}

model Fee {
  id           String   @id @default(cuid())
  amountTotal  Float
  amountPaid   Float
  dueDate      DateTime
  status       String
  paidAt       DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt @default(now())

  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  payments     FeePayment[]
}

model FeePayment {
  id             String    @id @default(cuid())
  receiptNo      String    @unique
  amount         Float
  paymentMode    String    // "UPI", "CASH", "CARD", "CHEQUE", "NET_BANKING"
  transactionRef String?   // UTR / Cheque No / Card Auth
  notes          String?
  paidAt         DateTime  @default(now())
  receivedBy     String?   // Admin / Cashier name

  feeId          String
  fee            Fee       @relation(fields: [feeId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InstituteInvoice {
  id                String    @id @default(cuid())
  amount            Float
  status            String    @default("PENDING") // "PAID", "OVERDUE", "PENDING"
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate           DateTime
  paidAt            DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt @default(now())

  instituteId       String
  institute         Institute @relation(fields: [instituteId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  details     String
  severity    String   @default("INFO") // "INFO", "WARNING", "CRITICAL"
  targetId    String?
  targetType  String?
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id            String    @id @default(cuid())
  title         String
  description   String
  type          String    @default("BUG") // "BUG", "FEEDBACK", "FEATURE_REQUEST", "SUPPORT"
  severity      String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status        String    @default("OPEN") // "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  
  reporterName  String
  reporterEmail String
  reporterPhone String?
  reporterRole  String    // "INSTITUTE_ADMIN", "TEACHER", "STUDENT"
  
  instituteId   String?
  institute     Institute? @relation(fields: [instituteId], references: [id])
  
  adminNotes    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())
}

model TeacherPayout {
  id             String    @id @default(cuid())
  month          Int       // 1 - 12
  year           Int       // e.g. 2026
  baseSalary     Float
  bonus          Float     @default(0)
  deductions     Float     @default(0)
  netAmount      Float
  status         String    @default("PAID") // "PAID", "PENDING"
  paymentMode    String    // "NET_BANKING", "UPI", "CHEQUE", "CASH"
  transactionRef String?   // Bank UTR, Cheque No, etc.
  voucherNo      String    @unique
  paidAt         DateTime  @default(now())
  notes          String?

  teacherId      String
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  instituteId    String
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  content     String
  priority    String    @default("NORMAL") // "NORMAL", "HIGH", "URGENT"

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())
}

